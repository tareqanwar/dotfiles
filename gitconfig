[user]
	name = Tareq Anwar
	email = trqnwr@gmail.com

[init]
	defaultBranch = main

[core]
	editor = nvim
	autocrlf = input
	pager = delta

[pull]
	rebase = true

[rebase]
	autoStash = true
	updateRefs = true

[fetch]
	prune = true
	pruneTags = true

[push]
	default = current
	autoSetupRemote = true

[merge]
	conflictStyle = zdiff3

[diff]
	colorMoved = default
	algorithm = histogram

[rerere]
	enabled = true
	autoupdate = true

[help]
	autocorrect = prompt

[branch]
	sort = -committerdate

[tag]
	sort = version:refname

[alias]
	# status and inspection
	s = status -sb
	st = status
	lg = log --graph --decorate --pretty=format:'%C(yellow)%h%Creset %C(cyan)%ad%Creset %C(green)%an%Creset %C(auto)%d%Creset %s' --date=short
	last = log -1 HEAD --stat
	who = shortlog -sn
	br = branch -vv
	# commits
	c = commit
	ca = commit --amend
	cm = commit -m
	fixup = commit --fixup

	# branching/switching
	co = checkout
	sw = switch
	swc = switch -c
	unstage = restore --staged

	# syncing
	up = !git fetch --all --prune --tags && git rebase --autostash --rebase-merges @{u}

	# quality of life
	tree = log --graph --decorate --oneline --all
	aliases = config --get-regexp '^alias\\.'

[delta]
	navigate = true
	line-numbers = true
	side-by-side = true
	syntax-theme = OneHalfDark

[interactive]
	diffFilter = delta --color-only

[pager]
	diff = delta
	log = delta
	reflog = delta
	show = delta

[includeIf "gitdir:~/work/"]
	path = ~/.gitconfig-work
